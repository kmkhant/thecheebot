# Copy to .env and fill in. Never commit .env.

# From @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# Where the SQLite file lives. In Docker this is normally /data/cheebot.db
CHEEBOT_DB_PATH=cheebot.db

# Search behaviour
CHEEBOT_DEFAULT_RADIUS_M=1000
CHEEBOT_MAX_RADIUS_M=25000
CHEEBOT_RESULTS_LIMIT=5

# Reject a new submission that lands this close to an existing toilet
CHEEBOT_DEDUPE_RADIUS_M=30

# Hide a toilet automatically once this many different users report it
CHEEBOT_REPORT_HIDE_THRESHOLD=3

# Max places one user may add per 24h
CHEEBOT_DAILY_SHARE_LIMIT=10

# First-guess language: my (Burmese, the default), en or zh.
# Users can switch any time with /language.
CHEEBOT_DEFAULT_LANGUAGE=my

# Salt for hashing Telegram user ids. Set this to any long random string.
CHEEBOT_USER_HASH_SALT=change-me-to-a-long-random-string

# Set to DEBUG when running locally to see library logs.
CHEEBOT_LOG_LEVEL=INFO

# Drop messages that queued up while the bot was offline (handy in development).
CHEEBOT_DROP_PENDING=false
